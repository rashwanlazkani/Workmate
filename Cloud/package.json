{
  "name": "workmate-cloud",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "synth": "cdk synth --quiet",
    "check": "npm run build && npm run test && npm run synth",
    "deploy": "tsx scripts/deploy.ts",
    "cdk": "cdk",
    "invite": "tsx scripts/invite.ts",
    "test:cloud": "tsx scripts/native-cloud-check.ts",
    "format": "prettier --write src server infra scripts tests",
    "provision:drive": "tsx scripts/provision-drive.ts",
    "test:drive": "tsx scripts/drive-cloud-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.900.0",
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/client-scheduler": "^3.900.0",
    "@aws-sdk/client-secrets-manager": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "@aws-sdk/util-dynamodb": "^3.900.0",
    "aws-cdk-lib": "^2.220.0",
    "constructs": "^10.4.2",
    "luxon": "^3.7.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.18.0",
    "aws-cdk": "^2.1030.0",
    "esbuild": "^0.25.10",
    "prettier": "^3.9.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "description": "Optional AWS backend for the native Workmate macOS app"
}
